@page
@model IndexModel

@{
  ViewData["Title"] = "Bøger";
}

<h1>Bogliste</h1>

<p>
  <a asp-page="Create" class="btn btn-primary">Opret ny bog</a>
</p>

@if (TempData["Success"] is string message) {
  <div class="alert alert-success alert-dismissible fade show" role="alert">
    @message
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
}

<table class="table table-striped table-hover">
  <thead>
    <tr>
      <th>Titel</th>
      <th>Forfatter</th>
      <th>Sidetal</th>
      <th>Pris</th>
      <th>Udgivelsesår</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  @foreach (Book item in Model.Books) {
    <tr>
      <td>@item.Title</td>
      <td>@item.Author</td>
      <td>@item.Pages</td>
      <td>@item.Price.ToString("N2")</td>
      <td>@item.Published</td>
      <td>
        <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Detaljer</a>
        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Rediger</a>
        <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Slet</a>
      </td>
    </tr>
  }
  </tbody>
</table>
