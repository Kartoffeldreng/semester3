@page "{id:int}"
@model EditModel

@{
  ViewData["Title"] = "Rediger bog";
}

<h1>Rediger bog</h1>
<hr />

<div class="row">
  <div class="col-md-6">
    <form asp-page="Edit" method="post">
      <div asp-validation-summary="All" class="text-danger"></div>

      <div class="form-group mb-3">
        <label for="Title" class="control-label">Titel</label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label for="Author" class="control-label">Forfatter</label>
        <input asp-for="Input.Author" class="form-control" />
        <span asp-validation-for="Input.Author" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label for="Pages" class="control-label">Sidetal</label>
        <input asp-for="Input.Pages" class="form-control" />
        <span asp-validation-for="Input.Pages" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label for="Price" class="control-label">Pris</label>
        <input asp-for="Input.Price" class="form-control" />
        <span asp-validation-for="Input.Price" class="text-danger"></span>
      </div>

      <div class="form-group mb-3">
        <label for="Published" class="control-label">Udgivelsesår</label>
        <input asp-for="Input.Published" class="form-control" />
        <span asp-validation-for="Input.Published" class="text-danger"></span>
      </div>

      <div class="form-group mt-4">
        <button type="submit" class="btn btn-primary">Gem ændringer</button>
        <a asp-page="Index" class="btn btn-secondary">Annullér</a>
      </div>
    </form>
  </div>
</div>
